# VCB sao kê Google Sheet (CSV export; cached 3600s on /tai-chinh)
# VCB_STATEMENTS_SHEET_ID=1boFEZqKH6k3FInRddydMpFXs2MaSlSa794OEFyoWgHg
# VCB_STATEMENTS_SHEET_GID=0

# Báo cáo tài chính — synced to Supabase for /bao-cao
# Default: npm run sync:bao-cao (plain Node.js; reads monthly Word reports from Google Drive)
# Optional sheet mode: npm run sync:bao-cao -- --from-sheet
# FINANCIAL_REPORTS_DRIVE_FOLDER_ID=1tlzUAOJrMtL5pZtvTSwPAMNFqz7OlPoK
# FINANCIAL_REPORTS_SHEET_ID=
# FINANCIAL_REPORTS_SHEET_GID=0

# Chứng từ chi — monthly school disbursement Google Sheets (/tai-chinh#chung-tu-chi)
# Default: npm run sync:chung-tu-chi (validates CSV + discovers new sheets from Drive folder)
# EXPENSE_DOCS_DRIVE_FOLDER_ID=1YJD2fy_dL12yUU4Q6GX8IdeNRgcSWONH
# EXPENSE_DOCS_SHEET_MAY_2026_ID=13cljtyGE0FRoTY92intN8cw5zFhLY07FzyOHPnNux0I
